{
  "name": "patina",
  "private": true,
  "version": "0.1.0",
  "description": "Patina: desktop 3D PBR texture painting for humans and AI agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run test && npm run typecheck && npm run build -w @patina/headless && npm run build -w @patina/desktop",
    "patina": "node packages/headless/dist/patina.js",
    "desktop": "npm run tauri -w @patina/desktop -- dev",
    "desktop:build": "npm run tauri -w @patina/desktop -- build"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": "Dias Zhumagaliyev <hello@dias.now> (https://dias.now)",
  "homepage": "https://github.com/vibecoderkz/patina"
}
